{
  "manifest_version": 3,
  "name": "MN-Qronx – Nhắc việc & Báo thức Pomodoro",
  "description": "Việc hôm nay, chuông nhắc & báo thức đúng hạn, đồng hồ Pomodoro tập trung ngay trên trình duyệt – kể cả khi đóng tab web.",
  "version": "1.2.1",
  "permissions": ["alarms", "notifications", "storage", "scripting", "activeTab", "cookies"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://mn-qronx.id.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mn-qronx.id.vn/oauth-callback*"],
      "js": ["oauth-capture.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MN-Qronx – Công việc hôm nay"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
