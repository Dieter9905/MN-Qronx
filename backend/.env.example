[TEMPLATE]
# Server
PORT=8080
NODE_ENV=development

# Database – Postgres của Tiger Cloud (DB free của Render hết hạn 06/10/2026,
# xem docs/database.md). Lấy chuỗi kết nối trong console Tiger Cloud và giữ
# nguyên tham số sslmode. Chạy tại máy cũng có thể trỏ vào Postgres local.
# CHÚ Ý: chuỗi này nối thẳng vào dữ liệu THẬT của khách.
DATABASE_URL="postgresql://user:password@host:5432/taskalarm?sslmode=require"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (đăng nhập bằng Google)
# Lấy từ: https://console.google.com/apis/credentials → OAuth 2.0 Client IDs (Web)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Callback phải khớp chính xác URI đã khai báo trong Google Console
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# URL frontend (nhận redirect sau khi đăng nhập Google)
FRONTEND_URL=http://localhost:5173

# ── Email ────────────────────────────────────────────────────
# Gửi mã xác nhận đăng ký, quên mật khẩu, báo cáo tuần…
# Hai đường gửi: SMTP (bất kỳ nhà cung cấp) hoặc Resend (API HTTPS).
# Mailjet đã bị gỡ khỏi dự án — đừng thêm lại biến MAILJET_* / MAIL_HOURLY_LIMIT.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Địa chỉ người gửi; nên là hộp thư/tên miền thật đã cấu hình SPF/DKIM.
EMAIL_FROM=MN-Qronx <no-reply@mn-qronx.id.vn>

# Chọn đường gửi: auto (mặc định) = Resend nếu có key, không thì SMTP.
# Ép một đường: resend | smtp
MAIL_TRANSPORT=auto

# ── Resend (tuỳ chọn, khuyến nghị) ───────────────────────────
# Lấy key: https://resend.com → API Keys → Create API Key (bắt đầu bằng "re_")
# Thêm tên miền: https://resend.com/domains → Add Domain
# Rồi: cd backend && npm run mail:resend   (in ra bản ghi DNS cần thêm)
RESEND_API_KEY=
# Để trống → dùng EMAIL_FROM ở trên. Trước khi xác thực tên miền, Resend chỉ cho
# gửi từ onboarding@resend.dev tới chính email chủ tài khoản (tiện thử trước).
RESEND_FROM=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@taskalarm.com

# Firebase Cloud Messaging (optional – needed for mobile push)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# AI riêng của MN-Qronx (self-hosted) – xem thư mục ai/ và ai/README.md
# Chạy tại máy: cd ai && pip install fastapi uvicorn && python serve.py
# Đã deploy: dán URL công khai của inference server, ĐỪNG có dấu / ở cuối.
AI_INFER_URL=http://localhost:8000
# Inference server hiện không bắt buộc key; chỉ đặt khi nó có xác thực
AI_API_KEY=
# Tên phiên bản model đang phục vụ (serve.py báo lại qua GET /health)
AI_MODEL_VERSION=mn-qronx-parser-v1
