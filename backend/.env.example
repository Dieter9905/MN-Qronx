[TEMPLATE]
[TEMPLATE]
# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/taskalarm?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (đăng nhập bằng Google)
# Lấy từ: https://console.google.com/apis/credentials → OAuth 2.0 Client IDs (Web)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Callback phải khớp chính xác URI đã khai báo trong Google Console
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# URL frontend (nhận redirect sau khi đăng nhập Google)
FRONTEND_URL=http://localhost:5173

# Email – gửi mã xác nhận đăng ký, quên mật khẩu…
# Mailjet: lấy API key + Secret key tại app.mailjet.com → Account settings → API keys
# BẮT BUỘC xác thực tên miền riêng (SPF/DKIM) + xác minh quyền sở hữu, xem docs/email-domain-setup.md
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your-mailjet-api-key
SMTP_PASS=your-mailjet-secret-key
SMTP_SECURE=false
# KHÔNG dùng @gmail.com (không thể gắn SPF/DKIM → thư vào spam/bị chặn)
EMAIL_FROM=MN-Qronx <no-reply@mn-qronx.id.vn>
# Host TXT xác nhận sở hữu tên miền (Mailjet → Validate your domain → Option 2)
# Tên host PHẢI có dấu chấm: mailjet._<8 ký tự đầu của token>
# Script mail:check tự lấy giá trị đúng từ Mailjet API, dòng này chỉ là dự phòng
MAILJET_OWNERSHIP_HOST=mailjet._93f3b17d

# ── Mailjet Send API v3.1 (nên dùng thay SMTP) ───────────────
# auto (mặc định): dùng API khi có key, không thì SMTP | api | smtp
# API trả về mã lỗi thật (vd tài khoản bị khoá: 401 mj-0001), còn SMTP có thể
# nhận lệnh rồi bỏ luôn thư nên "gửi thành công" qua SMTP không đáng tin.
MAIL_TRANSPORT=auto
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
# true = chỉ kiểm tra payload, KHÔNG gửi thật (dùng khi thử cấu hình)
MAILJET_SANDBOX=false

# ── Hạn mức gửi (tài khoản đang ở giai đoạn duyệt tạm) ──────
# Hai nguồn nói khác nhau: dashboard Mailjet ghi "10 emails per hour", mail hỗ trợ
# 18/09/2026 ghi 10 thư/ngày. App kiểm tra CẢ HAI và áp dụng cái chặt hơn — mỗi lần
# gửi thất bại đều là tín hiệu xấu khi Mailjet xét duyệt lại.
# 0 = TẮT kiểm tra cửa sổ đó (đặt sau khi Mailjet gỡ giới hạn).
MAIL_HOURLY_LIMIT=10
MAIL_DAILY_LIMIT=10
# Múi giờ dùng để chia "một giờ"/"một ngày" (Mailjet reset hạn mức theo giờ)
MAIL_QUOTA_TZ=Asia/Ho_Chi_Minh

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@taskalarm.com

# Firebase Cloud Messaging (optional – needed for mobile push)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# AI thật (9Router – OpenAI-compatible gateway)
# Cài 9Router: npm install -g 9router && 9router (dashboard: http://localhost:20128)
# Lấy API key tại dashboard → mục API Key / Endpoint
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your-9router-api-key
AI_MODEL=kr/claude-sonnet-4.5
