// ─────────────────────────────────────────────────────────
// TaskAlarm – Prisma Schema
// Based on: BA/03_TaskAlarm_ERD.md + taskalarm_postgresql_schema.sql
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum RoleName {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  SCHEDULED
  TRIGGERED
  SNOOZED
  DISMISSED
  CANCELLED
}

enum NotificationAction {
  SENT
  SNOOZED
  DISMISSED
}

enum Platform {
  WEB
  ANDROID
  IOS
}

enum Plan {
  FREE
  PLUS
  PRO
}

// ─── Thanh toán & quyền lợi theo gói ───────────────────────
enum BillingProvider {
  VIETQR   // chuyển khoản ngân hàng (VietQR) – người dùng tự khai, admin đối soát
  WEBHOOK  // Casso/Sepay tự động khớp lệnh chuyển khoản
  MOMO
  PLAY     // Google Play Billing (app Android)
  ADMIN    // admin tặng/đổi gói thủ công
  TRIAL    // dùng thử 7 ngày
  REWARD   // đổi điểm lấy ngày dùng gói
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  CREDITED
  REJECTED
}

// ─────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────

model Role {
  roleId      Int      @id @default(autoincrement()) @map("role_id")
  roleName    RoleName @unique @map("role_name")
  description String?  @db.VarChar(255)

  users User[]

  @@map("roles")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  roleId       Int      @map("role_id")
  fullName     String   @db.VarChar(150) @map("full_name")
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phoneNumber  String?  @db.VarChar(20) @map("phone_number")
  avatarUrl    String?  @db.VarChar(500) @map("avatar_url")
  googleId     String?  @unique @map("google_id")
  plan         Plan     @default(FREE)
  // Lịch sử gói trả phí: ngày bắt đầu & ngày hết hạn (30 ngày / kỳ đăng ký)
  planStartedAt DateTime? @map("plan_started_at")
  planExpiresAt DateTime? @map("plan_expires_at")
  // ── Hệ thống phần thưởng: điểm, chuỗi đăng nhập, mã mời ──
  points         Int       @default(0)
  loginStreak    Int       @default(0) @map("login_streak")
  lastLoginDate  DateTime? @map("last_login_date")
  inviteCode     String?   @unique @map("invite_code") @db.VarChar(16)
  referrerId     Int?      @map("referrer_id")
  // Dùng thử Pro: chỉ được dùng 1 lần cho mỗi tài khoản
  trialStartedAt DateTime? @map("trial_started_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                   Role                   @relation(fields: [roleId], references: [roleId])
  passwordResetRequests  PasswordResetRequest[]
  categories             Category[]
  tasks                  Task[]
  devices                Device[]
  webPushSubscriptions   WebPushSubscription[]
  // Khóa riêng cho tệp lịch .ics — app lịch (Google/Outlook) đọc bằng URL có
  // khóa này chứ không được mang mật khẩu, nên khóa phải làng riêng và xoay được
  icsKey                 String?  @db.VarChar(64) @map("ics_key")
  @@index([icsKey], map: "ix_app_users_ics_key")
  customSounds           CustomSound[]
  notificationSetting    NotificationSetting?
  refreshTokens          RefreshToken[]
  pointTransactions      PointTransaction[]
  invitesSent            Invitation[]            @relation("InviterInvitations")
  invitesReceived        Invitation[]            @relation("InviteeInvitation")
  supportConversation    SupportConversation?
  supportMessages        SupportMessage[]        @relation("SupportAuthor")
  subscriptions          Subscription[]
  paymentOrders          PaymentOrder[]
  aiUsages               AiUsage[]

  @@index([roleId])
  @@index([referrerId])
  @@map("app_users")
}

// ─── Điểm phần thưởng (lịch sử cộng/trừ điểm) ────────────────
model PointTransaction {
  pointTransactionId Int      @id @default(autoincrement()) @map("point_transaction_id")
  userId             Int      @map("user_id")
  amount             Int      // dương: cộng; âm: trừ (đổi thưởng)
  reason             String   @db.VarChar(30) // DAILY_LOGIN | STREAK_BONUS | INVITE | REDEEM_REWARD
  note               String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("point_transactions")
}

// ─── Lời mời bạn bè (chống lạm dụng: 1 IP + 1 thiết bị = 1 tài khoản) ──
model Invitation {
  invitationId Int              @id @default(autoincrement()) @map("invitation_id")
  inviterId    Int              @map("inviter_id")
  inviteeId    Int              @map("invitee_id")
  inviteCode   String           @db.VarChar(16) @map("invite_code")
  ipAddress    String?          @map("ip_address") @db.VarChar(64)
  deviceId     String?          @map("device_id") @db.VarChar(128)
  status       InvitationStatus @default(PENDING)
  creditedAt   DateTime?        @map("credited_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  inviter User @relation("InviterInvitations", fields: [inviterId], references: [userId])
  invitee User @relation("InviteeInvitation", fields: [inviteeId], references: [userId])

  @@index([inviterId])
  @@index([inviteeId])
  @@map("invitations")
}

// ─── Mã xác minh email khi đăng ký ─────────────────────────
// 1 email = 1 tài khoản: bảng lưu mã OTP gửi qua email,
// register chỉ tạo tài khoản khi mã hợp lệ (chưa hết hạn, chưa dùng).
model EmailVerificationCode {
  emailVerificationId Int       @id @default(autoincrement()) @map("email_verification_id")
  email               String    @db.VarChar(254)
  code                String    @db.VarChar(6)
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_codes")
}

model PasswordResetRequest {
  resetRequestId Int      @id @default(autoincrement()) @map("reset_request_id")
  userId         Int      @map("user_id")
  resetToken     String   @unique @db.VarChar(255) @map("reset_token")
  expiresAt      DateTime @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("password_reset_requests")
}

model Category {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  userId       Int      @map("user_id")
  categoryName String   @db.VarChar(100) @map("category_name")
  colorCode    String?  @db.VarChar(20) @map("color_code")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [userId])
  tasks Task[]

  @@unique([userId, categoryName])
  @@index([userId, isActive], map: "ix_categories_user_id")
  @@map("categories")
}

model Task {
  taskId        Int          @id @default(autoincrement()) @map("task_id")
  userId        Int          @map("user_id")
  categoryId    Int?         @map("category_id")
  parentTaskId  Int?         @map("parent_task_id")
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueAt         DateTime     @map("due_at")
  repeatType    RepeatType   @default(NONE) @map("repeat_type")
  // Ngày trong tuần cho lặp Hằng tuần (ISO 8601: 1=Thứ 2 … 7=Chủ nhật), chuỗi "1,3,5"
  repeatDays    String?      @db.VarChar(20) @map("repeat_days")
  completedAt   DateTime?    @map("completed_at")
  // Thùng rác: xoá là ĐẶT ngày này chứ không xoá dòng — còn giữ được 30 ngày
  // để khôi phục (người dùng không sợ mất dữ liệu). Mọi truy vấn đều lọc
  // deletedAt = null để việc trong thùng rác không hiện ở list/dashboard.
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [userId])
  category     Category?   @relation(fields: [categoryId], references: [categoryId])
  parentTask   Task?       @relation("TaskRepetition", fields: [parentTaskId], references: [taskId])
  childTasks   Task[]      @relation("TaskRepetition")
  subtasks     Subtask[]
  reminders    Reminder[]

  @@index([userId, dueAt], map: "ix_tasks_user_due")
  @@index([userId, status], map: "ix_tasks_user_status")
  @@index([userId, deletedAt], map: "ix_tasks_user_deleted")
  @@index([categoryId], map: "ix_tasks_category_id")
  @@index([parentTaskId], map: "ix_tasks_parent_task_id")
  @@map("tasks")
}

model Subtask {
  subtaskId    Int      @id @default(autoincrement()) @map("subtask_id")
  taskId       Int      @map("task_id")
  content      String   @db.VarChar(255)
  isCompleted  Boolean  @default(false) @map("is_completed")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId, displayOrder], map: "ix_subtasks_task_order")
  @@map("subtasks")
}

model Reminder {
  reminderId  Int            @id @default(autoincrement()) @map("reminder_id")
  taskId      Int            @map("task_id")
  remindAt    DateTime       @map("remind_at")
  status      ReminderStatus @default(SCHEDULED)
  snoozeCount Int            @default(0) @map("snooze_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  task             Task              @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@index([status, remindAt], map: "ix_reminders_status_remind_at")
  @@index([taskId], map: "ix_reminders_task_id")
  @@map("reminders")
}

model Device {
  deviceId    Int      @id @default(autoincrement()) @map("device_id")
  userId      Int      @map("user_id")
  deviceToken String   @unique @db.VarChar(500) @map("device_token")
  platform    Platform
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [userId])
  notificationLogs NotificationLog[]

  @@index([userId, isActive], map: "ix_devices_user_id")
  @@map("devices")
}

// ─── Web Push cho PWA ─────────────────────────────────────
// Đăng ký từ trình duyệt: có dòng này thì báo thức/chỉ báo vẫn kêu khi người
// dùng ĐÓNG tab — thứ trước đây làm app nhắc việc im lặng nên không bán được.
model WebPushSubscription {
  subscriptionId Int      @id @default(autoincrement()) @map("subscription_id")
  userId         Int      @map("user_id")
  // Endpoint của trình duyệt (Chrome/Firefox cấp) — khoá chống trùng
  endpoint       String   @unique @db.VarChar(500)
  p256dh         String   @db.VarChar(200)
  auth           String   @db.VarChar(100)
  userAgent      String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")
  // Ghi lại khi gửi thành công để biết subscription còn sống không
  lastUsedAt     DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

// Cấu hình hệ thống dạng khoá/giá trị (VAPID, cờ bật/tắt…) — lưu trong DB để
// không phải cấu hình biến môi trường mỗi khi đổi máy hay redeploy.
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model NotificationLog {
  notificationLogId Int                @id @default(autoincrement()) @map("notification_log_id")
  reminderId        Int                @map("reminder_id")
  deviceId          Int?               @map("device_id")
  action            NotificationAction
  sentAt            DateTime           @default(now()) @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId])
  device   Device?  @relation(fields: [deviceId], references: [deviceId])

  @@index([reminderId, sentAt], map: "ix_notification_logs_reminder_id")
  @@index([deviceId], map: "ix_notification_logs_device_id")
  @@map("notification_logs")
}

model CustomSound {
  customSoundId Int      @id @default(autoincrement()) @map("custom_sound_id")
  userId        Int      @map("user_id")
  name          String   @db.VarChar(120)
  mimeType      String   @default("audio/mpeg") @db.VarChar(60) @map("mime_type")
  sizeBytes     Int      @default(0) @map("size_bytes")
  data          Bytes
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "ix_custom_sounds_user_id")
  @@map("custom_sounds")
}

model NotificationSetting {
  notificationSettingId Int      @id @default(autoincrement()) @map("notification_setting_id")
  userId                Int      @unique @map("user_id")
  alarmSound            String   @default("DEFAULT") @db.VarChar(50) @map("alarm_sound")
  defaultSnoozeMinutes  Int      @default(5) @map("default_snooze_minutes")
  vibrationEnabled      Boolean  @default(true) @map("vibration_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("notification_settings")
}

model RefreshToken {
  tokenId   Int      @id @default(autoincrement()) @map("token_id")
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── CSKH: hội thoại hỗ trợ giữa người dùng và admin ────────

enum SupportStatus {
  OPEN
  RESOLVED
}

enum SupportSender {
  USER
  ADMIN
}

// ─── Quyền lợi theo gói: lịch sử đăng ký (nguồn sự thật của gói) ───
// user.plan / planExpiresAt là bản "vật chất hoá" để mọi chỗ kiểm tra gói cũ
// vẫn chạy; mỗi lần kích hoạt/gia hạn đều ghi thêm một dòng ở đây để có lịch sử.
model Subscription {
  subscriptionId Int                @id @default(autoincrement()) @map("subscription_id")
  userId         Int                @map("user_id")
  plan           Plan
  cycle          BillingCycle       @default(MONTHLY)
  provider       BillingProvider
  status         SubscriptionStatus @default(ACTIVE)
  // Mã giao dịch phía nhà cung cấp: mã đơn, purchase token của Play…
  providerRef    String?            @map("provider_ref") @db.VarChar(190)
  startedAt      DateTime           @default(now()) @map("started_at")
  expiresAt      DateTime           @map("expires_at")
  autoRenew      Boolean             @default(false) @map("auto_renew")
  cancelledAt    DateTime?           @map("cancelled_at")
  // Nhắc trước khi hết hạn đã gửi cho kỳ này chưa — mỗi kỳ tối đa 1 lần, nên
  // cột này cũng là chốt chặn chống spam email cho người dùng.
  reminderSentAt DateTime?           @map("reminder_sent_at")
  note           String?            @db.VarChar(255)
  createdAt      DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

// ─── Đơn thanh toán (VietQR trước, Play Billing sau) ────────
model PaymentOrder {
  orderId        Int             @id @default(autoincrement()) @map("order_id")
  orderCode      String          @unique @map("order_code") @db.VarChar(32)
  userId         Int             @map("user_id")
  plan           Plan
  cycle          BillingCycle    @default(MONTHLY)
  amount         Int             // Số tiền VND
  status         OrderStatus     @default(PENDING)
  provider       BillingProvider @default(VIETQR)
  providerRef    String?         @map("provider_ref") @db.VarChar(190)
  // Nội dung chuyển khoản: chính là orderCode để webhook khớp lệnh
  transferContent String         @map("transfer_content") @db.VarChar(120)
  // Mã QR của đơn: do hệ thống tự sinh (SYSTEM) hoặc do ngân hàng tạo qua API (BANK)
  qrPayload       String?        @map("qr_payload") @db.Text
  qrImageUrl      String?        @map("qr_image_url") @db.Text
  qrSource        String?        @map("qr_source") @db.VarChar(10)
  qrCreatedAt     DateTime?      @map("qr_created_at")
  paidAt         DateTime?       @map("paid_at")
  expiresAt      DateTime        @map("expires_at")
  confirmedBy    Int?            @map("confirmed_by")
  note           String?         @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("payment_orders")
}

// ─── Nhật ký sự kiện thanh toán (chống xử lý trùng webhook) ──
model BillingEvent {
  billingEventId Int             @id @default(autoincrement()) @map("billing_event_id")
  provider       BillingProvider
  eventType      String          @map("event_type") @db.VarChar(40)
  // Mã duy nhất phía nhà cung cấp (id giao dịch, purchase token…) → chống trùng
  externalId     String          @unique @map("external_id") @db.VarChar(190)
  orderId        Int?            @map("order_id")
  amount         Int?
  payload        Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("billing_events")
}

// ─── Cấu hình nhận tiền (admin đặt ngay trong app, không cần sửa biến môi trường) ───
// Bảng chỉ có đúng một dòng (settingId = 1). Giá trị ở đây ĐÈ lên biến môi trường,
// nhờ vậy đổi ngân hàng / số tài khoản không phải khởi động lại máy chủ.
model BillingSetting {
  settingId       Int      @id @default(1) @map("setting_id")
  bankId          String?  @map("bank_id") @db.VarChar(20)
  bankAccount     String?  @map("bank_account") @db.VarChar(40)
  bankAccountName String?  @map("bank_account_name") @db.VarChar(80)
  qrTemplate      String?  @map("qr_template") @db.VarChar(20)
  // Mã xác thực webhook (SePay/Casso gửi kèm) — sinh được từ trang quản trị
  webhookSecret   String?  @map("webhook_secret") @db.VarChar(120)

  // ─── Đọc giao dịch bằng API ngân hàng (không cần webhook, không cần xác nhận tay)
  // SEPAY: API Giao dịch của SePay (dùng được ngay). ACB: Open API ACB ONE CONNECT
  // (cần hợp đồng với ACB rồi điền thông số kỹ thuật ACB cấp cho đối tác).
  bankApiProvider     String?   @map("bank_api_provider") @db.VarChar(20)
  bankApiBaseUrl      String?   @map("bank_api_base_url") @db.VarChar(190)
  bankApiToken        String?   @map("bank_api_token") @db.VarChar(255)
  bankApiClientId     String?   @map("bank_api_client_id") @db.VarChar(190)
  bankApiClientSecret String?   @map("bank_api_client_secret") @db.VarChar(255)
  bankApiTokenUrl     String?   @map("bank_api_token_url") @db.VarChar(190)
  bankApiHistoryPath  String?   @map("bank_api_history_path") @db.VarChar(190)
  // Số tài khoản gửi lên API (mặc định lấy số tài khoản nhận tiền ở trên)
  bankApiAccount      String?   @map("bank_api_account") @db.VarChar(40)
  // Đường dẫn tạo QR động của ngân hàng (ACB cấp; dùng được {account} {amount}
  // {content} {orderCode}). Bỏ trống thì hệ thống tự sinh mã VietQR.
  bankApiQrPath       String?   @map("bank_api_qr_path") @db.VarChar(190)
  syncEnabled         Boolean   @default(false) @map("sync_enabled")
  syncIntervalMinutes Int?      @map("sync_interval_minutes")
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncStatus      String?   @map("last_sync_status") @db.VarChar(20)
  lastSyncMessage     String?   @map("last_sync_message") @db.VarChar(255)
  // Con trỏ chống đọc lại giao dịch cũ (since_id của SePay)
  lastSyncCursor      String?   @map("last_sync_cursor") @db.VarChar(60)

  updatedBy       Int?     @map("updated_by")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("billing_settings")
}

// ─── Hạn mức dùng AI theo ngày ──────────────────────────────
model AiUsage {
  aiUsageId Int    @id @default(autoincrement()) @map("ai_usage_id")
  userId    Int    @map("user_id")
  // Ngày theo múi giờ Việt Nam, dạng YYYY-MM-DD (so sánh chuỗi cho đơn giản)
  usageDate String @map("usage_date") @db.VarChar(10)
  count     Int    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@map("ai_usage")
}

model SupportConversation {
  supportConversationId Int           @id @default(autoincrement()) @map("support_conversation_id")
  userId                Int           @unique @map("user_id")
  status                SupportStatus @default(OPEN)
  lastMessagePreview    String?       @db.VarChar(160) @map("last_message_preview")
  lastMessageAt         DateTime      @default(now()) @map("last_message_at")
  unreadForAdmin        Int           @default(0) @map("unread_for_admin")
  unreadForUser         Int           @default(0) @map("unread_for_user")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  messages SupportMessage[]

  @@index([lastMessageAt], map: "ix_support_conversations_last_message")
  @@index([unreadForAdmin], map: "ix_support_conversations_unread_admin")
  @@map("support_conversations")
}

model SupportMessage {
  supportMessageId Int           @id @default(autoincrement()) @map("support_message_id")
  conversationId   Int           @map("conversation_id")
  senderRole       SupportSender @map("sender_role")
  authorId         Int?          @map("author_id")
  body             String        @db.Text
  readByUserAt     DateTime?     @map("read_by_user_at")
  readByAdminAt    DateTime?     @map("read_by_admin_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [supportConversationId], onDelete: Cascade)
  author       User?               @relation("SupportAuthor", fields: [authorId], references: [userId], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@index([conversationId, createdAt], map: "ix_support_messages_conversation")
  @@map("support_messages")
}

/// Ảnh khách hàng/admin gửi kèm trong hội thoại hỗ trợ.
/// Lưu thẳng trong DB (giống custom_sounds) để không phụ thuộc dịch vụ lưu file
/// bên ngoài — client nén ảnh trước khi gửi, server kiểm tra lại dung lượng.
model SupportAttachment {
  supportAttachmentId Int      @id @default(autoincrement()) @map("support_attachment_id")
  messageId           Int      @map("message_id")
  mimeType            String   @db.VarChar(80) @map("mime_type")
  sizeBytes           Int      @default(0) @map("size_bytes")
  data                Bytes
  createdAt           DateTime @default(now()) @map("created_at")

  message SupportMessage @relation(fields: [messageId], references: [supportMessageId], onDelete: Cascade)

  @@index([messageId], map: "ix_support_attachments_message")
  @@map("support_attachments")
}
