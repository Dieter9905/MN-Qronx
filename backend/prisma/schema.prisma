// ─────────────────────────────────────────────────────────
// TaskAlarm – Prisma Schema
// Based on: BA/03_TaskAlarm_ERD.md + taskalarm_postgresql_schema.sql
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum RoleName {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  SCHEDULED
  TRIGGERED
  SNOOZED
  DISMISSED
  CANCELLED
}

enum NotificationAction {
  SENT
  SNOOZED
  DISMISSED
}

enum Platform {
  WEB
  ANDROID
  IOS
}

enum Plan {
  FREE
  PLUS
  PRO
  // Pro Doanh nghiệp: mua một lần, dùng chung cho tới 10 tài khoản (chủ gói + 9 người).
  // Cùng quyền lợi với PRO — người trong nhóm không cần mua thêm gói riêng.
  BUSINESS
}

// ─── Thanh toán & quyền lợi theo gói ───────────────────────
enum BillingProvider {
  VIETQR   // chuyển khoản ngân hàng (VietQR) – người dùng tự khai, admin đối soát
  WEBHOOK  // Casso/Sepay tự động khớp lệnh chuyển khoản
  MOMO
  PLAY     // Google Play Billing (app Android)
  ADMIN    // admin tặng/đổi gói thủ công
  TRIAL    // dùng thử 7 ngày
  REWARD   // đổi điểm lấy ngày dùng gói
  // Chỗ ngồi trong gói doanh nghiệp của người khác: KHÔNG phải tiền khách trả, nên phải
  // tách khỏi các provider ở trên để báo cáo doanh thu không đếm nhầm thành khách trả tiền.
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  CREDITED
  REJECTED
}

// ─── Không gian làm việc (3 chế độ sống chung trong 1 tài khoản) ──

// PERSONAL: riêng tư mặc định — không bắt buộc tạo dòng, task cũ (taskWorkspaceId = null)
// chính là ko gian này nên mọi API cũ nghĩa không đổi.
enum WorkspaceType {
  PERSONAL
  STUDENT // Lớp học: lịch học import từ trường + việc theo lớp
  TEAM    // Nhóm làm việc: phân công kiểu Jira (Owner trả gói)
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────

model Role {
  roleId      Int      @id @default(autoincrement()) @map("role_id")
  roleName    RoleName @unique @map("role_name")
  description String?  @db.VarChar(255)

  users User[]

  @@map("roles")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  roleId       Int      @map("role_id")
  fullName     String   @db.VarChar(150) @map("full_name")
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phoneNumber  String?  @db.VarChar(20) @map("phone_number")
  avatarUrl    String?  @db.VarChar(500) @map("avatar_url")
  googleId     String?  @unique @map("google_id")
  plan         Plan     @default(FREE)
  // Lịch sử gói trả phí: ngày bắt đầu & ngày hết hạn (30 ngày / kỳ đăng ký)
  planStartedAt DateTime? @map("plan_started_at")
  planExpiresAt DateTime? @map("plan_expires_at")
  // ── Hệ thống phần thưởng: điểm, chuỗi đăng nhập, mã mời ──
  points         Int       @default(0)
  loginStreak    Int       @default(0) @map("login_streak")
  lastLoginDate  DateTime? @map("last_login_date")
  inviteCode     String?   @unique @map("invite_code") @db.VarChar(16)
  referrerId     Int?      @map("referrer_id")
  // Dùng thử Pro: chỉ được dùng 1 lần cho mỗi tài khoản
  trialStartedAt DateTime? @map("trial_started_at")
  // Báo cáo tuần qua email (quyền lợi gói Pro): gửi vào sáng thứ 2 hằng tuần.
  // weeklyReportSentAt lưu mốc gửi gần nhất để cron và nhịp /health gọi bao nhiêu
  // lần cũng chỉ gửi đúng một thư mỗi tuần cho mỗi khách.
  weeklyReportEnabled Boolean   @default(true) @map("weekly_report_enabled")
  weeklyReportSentAt  DateTime? @map("weekly_report_sent_at")
  // Lần gần nhất khách tự bấm "Gửi thử báo cáo tuần". Dùng để chặn bấm liên tục:
  // mỗi thư đều tính vào hạn mức gửi của nhà cung cấp, nên một người bấm thử nhiều
  // lần là hết chỗ cho thư thật của mọi khách khác.
  weeklyReportTestAt DateTime? @map("weekly_report_test_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                   Role                   @relation(fields: [roleId], references: [roleId])
  passwordResetRequests  PasswordResetRequest[]
  categories             Category[]
  tasks                  Task[]
  devices                Device[]
  webPushSubscriptions   WebPushSubscription[]
  // Lịch ngoài (Google Calendar / Outlook) nhập chiều đọc bằng URL .ics —
  // khách dán "Địa chỉ iCal riêng" một lần, backend tự kéo sự kiện về mỗi giờ.
  externalCalendars      ExternalCalendar[]
  // Khóa riêng cho tệp lịch .ics — app lịch (Google/Outlook) đọc bằng URL có
  // khóa này chứ không được mang mật khẩu, nên khóa phải làng riêng và xoay được
  icsKey                 String?  @db.VarChar(64) @map("ics_key")
  @@index([icsKey], map: "ix_app_users_ics_key")
  customSounds           CustomSound[]
  notificationSetting    NotificationSetting?
  refreshTokens          RefreshToken[]
  pointTransactions      PointTransaction[]
  // Giao việc (Pro): assignedShares = việc người khác nhờ tôi, sharedTasks = việc tôi nhờ người khác
  assignedShares         TaskShare[]             @relation("TaskShareAssignee")
  sharedTasks            TaskShare[]             @relation("TaskShareSharedBy")
  // Gói Pro Doanh nghiệp: ownedFamilyMembers = những người tôi cho dùng ké, familyMembership = chỗ của tôi trong nhóm người khác
  ownedFamilyMembers     FamilyMember[]          @relation("FamilyOwner")
  familyMembership       FamilyMember?           @relation("FamilyMemberUser")
  invitesSent            Invitation[]            @relation("InviterInvitations")
  invitesReceived        Invitation[]            @relation("InviteeInvitation")
  supportConversation    SupportConversation?
  supportMessages        SupportMessage[]        @relation("SupportAuthor")
  subscriptions          Subscription[]
  paymentOrders          PaymentOrder[]
  aiUsages               AiUsage[]
  // Không gian làm việc: một người một dòng member cho mỗi không gian (một cặp duy nhất)
  workspaceMemberships   WorkspaceMember[]
  ownedWorkspaces        Workspace[]       @relation("WorkspaceOwner")

  @@index([roleId])
  @@index([referrerId])
  @@map("app_users")
}

// ─── Điểm phần thưởng (lịch sử cộng/trừ điểm) ────────────────
model PointTransaction {
  pointTransactionId Int      @id @default(autoincrement()) @map("point_transaction_id")
  userId             Int      @map("user_id")
  amount             Int      // dương: cộng; âm: trừ (đổi thưởng)
  reason             String   @db.VarChar(30) // DAILY_LOGIN | STREAK_BONUS | INVITE | REDEEM_REWARD
  note               String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("point_transactions")
}

// ─── Lời mời bạn bè (chống lạm dụng: 1 IP + 1 thiết bị = 1 tài khoản) ──
model Invitation {
  invitationId Int              @id @default(autoincrement()) @map("invitation_id")
  inviterId    Int              @map("inviter_id")
  inviteeId    Int              @map("invitee_id")
  inviteCode   String           @db.VarChar(16) @map("invite_code")
  ipAddress    String?          @map("ip_address") @db.VarChar(64)
  deviceId     String?          @map("device_id") @db.VarChar(128)
  status       InvitationStatus @default(PENDING)
  creditedAt   DateTime?        @map("credited_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  inviter User @relation("InviterInvitations", fields: [inviterId], references: [userId])
  invitee User @relation("InviteeInvitation", fields: [inviteeId], references: [userId])

  @@index([inviterId])
  @@index([inviteeId])
  @@map("invitations")
}

// ─── Mã xác minh email khi đăng ký ─────────────────────────
// 1 email = 1 tài khoản: bảng lưu mã OTP gửi qua email,
// register chỉ tạo tài khoản khi mã hợp lệ (chưa hết hạn, chưa dùng).
model EmailVerificationCode {
  emailVerificationId Int       @id @default(autoincrement()) @map("email_verification_id")
  email               String    @db.VarChar(254)
  code                String    @db.VarChar(6)
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_codes")
}

model PasswordResetRequest {
  resetRequestId Int      @id @default(autoincrement()) @map("reset_request_id")
  userId         Int      @map("user_id")
  resetToken     String   @unique @db.VarChar(255) @map("reset_token")
  expiresAt      DateTime @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("password_reset_requests")
}

model Category {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  userId       Int      @map("user_id")
  categoryName String   @db.VarChar(100) @map("category_name")
  colorCode    String?  @db.VarChar(20) @map("color_code")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [userId])
  tasks Task[]

  @@unique([userId, categoryName])
  @@index([userId, isActive], map: "ix_categories_user_id")
  @@map("categories")
}

model Task {
  taskId        Int          @id @default(autoincrement()) @map("task_id")
  userId        Int          @map("user_id")
  categoryId    Int?         @map("category_id")
  parentTaskId  Int?         @map("parent_task_id")
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueAt         DateTime     @map("due_at")
  repeatType    RepeatType   @default(NONE) @map("repeat_type")
  // Ngày trong tuần cho lặp Hằng tuần (ISO 8601: 1=Thứ 2 … 7=Chủ nhật), chuỗi "1,3,5"
  repeatDays    String?      @db.VarChar(20) @map("repeat_days")
  completedAt   DateTime?    @map("completed_at")
  // "Nhắc dai" (gói Pro): việc chưa xong thì chuông kêu lại mỗi N phút cho tới
  // khi người dùng bấm Xong. null = tắt. Đây là lý do trả tiền rõ nhất của Pro:
  // "nhắc là nhớ", chứ không phải nhắc một lần rồi thôi.
  nagEveryMinutes Int?       @map("nag_every_minutes")
  // Luân phiên người làm (gói Pro): việc lặp lại mà mỗi kỳ MỘT người chịu trách
  // nhiệm, xoay vòng theo thứ tự đã giao — "tuần này ai đổ rác". Không có cột này
  // thì chủ việc phải tự nhớ ai làm kỳ trước (đúng việc mà app nhắc việc sinh ra để
  // làm hộ), và cả nhà cùng nhận chuông rồi cùng đoán kỳ này đến lượt ai.
  rotateEnabled Boolean @default(false) @map("rotate_enabled")
  // Người đến lượt trong KỲ NÀY; kỳ sau được tính lại khi việc xong. Cố ý là Int
  // trần chứ không phải khoá ngoại: người bị gỡ khỏi việc sẽ làm cột này trỏ vào
  // người không còn trong danh sách, nên mọi chỗ đọc PHẢI đối chiếu lại với
  // task_shares (nextTurnAssignee / reminderTargetsForTask) thay vì tin cột này.
  turnAssigneeId Int?  @map("turn_assignee_id")
  // Thùng rác: xoá là ĐẶT ngày này chứ không xoá dòng — còn giữ được 30 ngày
  // để khôi phục (người dùng không sợ mất dữ liệu). Mọi truy vấn đều lọc
  // deletedAt = null để việc trong thùng rác không hiện ở list/dashboard.
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Không gian làm việc của công việc. null = ko gian Cá nhân mặc định
  // (cách an toàn nhất để Task cũ giữ nguyên vị thế không cần di chuyển dữ liệu:
  // mọi truy vấn cũ lọc null vẫn nhảy theo đúng logic mỗi cá nhân).
  taskWorkspaceId Int?      @map("task_workspace_id")

  user         User        @relation(fields: [userId], references: [userId])
  category     Category?   @relation(fields: [categoryId], references: [categoryId])
  workspace    Workspace?  @relation(fields: [taskWorkspaceId], references: [workspaceId])
  parentTask   Task?       @relation("TaskRepetition", fields: [parentTaskId], references: [taskId])
  childTasks   Task[]      @relation("TaskRepetition")
  subtasks     Subtask[]
  reminders    Reminder[]
  // Giao việc cho người khác (Pro) — xem model TaskShare
  shares       TaskShare[]

  @@index([taskWorkspaceId], map: "ix_tasks_workspace_id")
  @@index([userId, dueAt], map: "ix_tasks_user_due")
  @@index([userId, status], map: "ix_tasks_user_status")
  @@index([userId, deletedAt], map: "ix_tasks_user_deleted")
  @@index([categoryId], map: "ix_tasks_category_id")
  @@index([parentTaskId], map: "ix_tasks_parent_task_id")
  @@map("tasks")
}

model Subtask {
  subtaskId    Int      @id @default(autoincrement()) @map("subtask_id")
  taskId       Int      @map("task_id")
  content      String   @db.VarChar(255)
  isCompleted  Boolean  @default(false) @map("is_completed")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId, displayOrder], map: "ix_subtasks_task_order")
  @@map("subtasks")
}

// Giao việc cho người khác (gói Pro): chủ việc nhờ một tài khoản MN-Qronx khác
// làm hộ. Một dòng = "việc này giao cho người này".
//
// Tách khỏi Task vì hai lý do: (1) một việc có thể giao cho nhiều người, (2) NGƯỜI
// ĐƯỢC GIAO không được quyền sửa/xoá việc — họ chỉ đánh dấu xong phần của mình
// (doneAt). Nhờ vậy mọi truy vấn cũ vẫn khoá theo tasks.user_id như cũ, không có
// đường nào để người khác nhìn thấy hay sửa việc không phải của mình.
//
// Khối thùng rác: purgeExpired xoá cứng việc quá 30 ngày nên phải xoá share trước
// (kèm onDelete: Cascade cho an toàn).
model TaskShare {
  shareId    Int       @id @default(autoincrement()) @map("share_id")
  taskId     Int       @map("task_id")
  assigneeId Int       @map("assignee_id")
  sharedById Int       @map("shared_by_id")
  // Lời nhắn kèm theo ("em gửi chị bản báo cáo nhé") — hiện cùng việc cho người nhận
  note       String?   @db.VarChar(255)
  // Người được giao bấm "Xong phần của tôi". KHÁC trạng thái của việc: việc chỉ
  // hoàn thành khi CHỦ VIỆC bấm xong.
  doneAt     DateTime? @map("done_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  task     Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  assignee User @relation("TaskShareAssignee", fields: [assigneeId], references: [userId], onDelete: Cascade)
  sharedBy User @relation("TaskShareSharedBy", fields: [sharedById], references: [userId], onDelete: Cascade)

  @@unique([taskId, assigneeId], map: "ux_task_shares_task_assignee")
  @@index([assigneeId, doneAt], map: "ix_task_shares_assignee")
  @@index([sharedById], map: "ix_task_shares_shared_by")
  @@map("task_shares")
}

// ─── Không gian làm việc (Workspace) ─────────────────────────────
// Sống chung trong 1 tài khoản: Cá nhân (không cần dòng), Lớp học (STUDENT)
// và Nhóm làm việc (TEAM). Task luôn thuộc 1 ko gian; trang Lịch tổng hợp
//童话 đa nguồn (cá nhân + lớp + nhóm + lịch ngoài Google/Outlook).
//
// Gói hiệu lực theo NGOO CẢNH: task Cá nhân dùng gói của user; task trong
// STUDENT/TEAM dùng gói của OWNER không gian (workspace plan),.wallet nên
// resolve ở runtime mỗi request (mua 1 key cho cả nhóm – mô hình Slack/Jira).
model Workspace {
  workspaceId Int           @id @default(autoincrement()) @map("workspace_id")
  type        WorkspaceType
  name        String        @db.VarChar(150)
  ownerId     Int           @map("owner_id")
  // Mã mời cho TEAM/STUDENT: `NL-ABCD12`. null = chưa bật mời (chỉ Owner thuộc)
  inviteCode  String?       @unique @db.VarChar(16)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner   User               @relation("WorkspaceOwner", fields: [ownerId], references: [userId], onDelete: Cascade)
  members WorkspaceMember[]
  tasks   Task[]
  // Không gian STUDENT gắn đúng 1 trường (lịch học) — null cho PERSONAL/TEAM
  schoolLink    SchoolLink?
  // Tài khoản cổng trường đã kết nối (đăng nhập hộ để tự đồng bộ TKB)
  schoolAccount SchoolAccount?

  @@index([ownerId], map: "ix_workspaces_owner")
  @@index([type], map: "ix_workspaces_type")
  @@map("workspaces")
}

// Một người chỉ có một slot trong một không gian — nhưng CÓ THỂ nằm nhiều
// không gian cùng lúc (lớp có thể ở 2 trường / nhóm khác nhau): đó là
// đích mà thiết kế toàn bộ hướng đến.
model WorkspaceMember {
  workspaceMemberId Int          @id @default(autoincrement()) @map("workspace_member_id")
  workspaceId       Int          @map("workspace_id")
  userId            Int          @map("user_id")
  role              WorkspaceRole @default(MEMBER)
  // Ko gian xem mặc định khi request không mang header X-Workspace
  isDefault         Boolean      @default(false) @map("is_default")
  createdAt         DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "ux_workspace_member_pair")
  @@index([userId], map: "ix_workspace_members_user")
  @@map("workspace_members")
}

// ─── Gói Pro Doanh nghiệp ────────────────────────────────────────
// Một khách trả tiền cho cả nhóm: chủ gói mua BUSINESS và kéo tối đa 9 người nữa
// dùng chung (tổng 10 tài khoản có quyền Pro).
//
// Quyền lợi của người trong nhóm được VẬT CHẤT HOÁ trên chính `users.plan = PRO`
// (cùng Subscription.provider = BUSINESS) thay vì tính lại ở mỗi chỗ đọc gói — mỗi
// nơi tự suy ra "có được dùng Pro không" là cách chắc chắn để chỗ này cho qua,
// chỗ kia chặn. Cột/`planExpiresAt` của người trong nhóm luôn lấy theo chủ gói nên
// khi chủ hết hạn thì cả nhóm cùng hết (scheduler đồng bộ mỗi phút).
model FamilyMember {
  familyMemberId Int       @id @default(autoincrement()) @map("family_member_id")
  ownerId        Int       @map("owner_id")
  // Một người chỉ nằm trong đúng một nhóm (@@unique bên dưới) — tránh cùng lúc
  // nhận hai gói và không biết gói nào hết hạn trước.
  memberId       Int       @unique @map("member_id")
  note           String?   @db.VarChar(255)
  // Chủ gói có xem được tiến độ công việc của người này không (mục "Cả nhóm").
  // Mặc định BẬT vì đó là toàn bộ giá trị của gói doanh nghiệp, nhưng người trong nhóm
  // luôn tắt được — bị nhìn trộm việc riêng mà không biết là cách chắc chắn nhất
  // để họ rời nhóm, còn tắt được thì họ ở lại và tự quyết định.
  shareProgress  Boolean   @default(true) @map("share_progress")
  createdAt      DateTime  @default(now()) @map("created_at")

  owner  User @relation("FamilyOwner", fields: [ownerId], references: [userId], onDelete: Cascade)
  member User @relation("FamilyMemberUser", fields: [memberId], references: [userId], onDelete: Cascade)

  @@unique([ownerId, memberId], map: "ux_family_members_owner_member")
  @@index([ownerId], map: "ix_family_members_owner")
  @@map("family_members")
}

model Reminder {
  reminderId  Int            @id @default(autoincrement()) @map("reminder_id")
  taskId      Int            @map("task_id")
  remindAt    DateTime       @map("remind_at")
  status      ReminderStatus @default(SCHEDULED)
  snoozeCount Int            @default(0) @map("snooze_count")
  // Số lần đã nhắc lại trong chế độ nhắc dai — dừng khi việc xong hoặc hết trần
  nagCount    Int            @default(0) @map("nag_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  task             Task              @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@index([status, remindAt], map: "ix_reminders_status_remind_at")
  @@index([taskId], map: "ix_reminders_task_id")
  @@map("reminders")
}

model Device {
  deviceId    Int      @id @default(autoincrement()) @map("device_id")
  userId      Int      @map("user_id")
  deviceToken String   @unique @db.VarChar(500) @map("device_token")
  platform    Platform
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [userId])
  notificationLogs NotificationLog[]

  @@index([userId, isActive], map: "ix_devices_user_id")
  @@map("devices")
}

// ─── Web Push cho PWA ─────────────────────────────────────
// Đăng ký từ trình duyệt: có dòng này thì báo thức/chỉ báo vẫn kêu khi người
// dùng ĐÓNG tab — thứ trước đây làm app nhắc việc im lặng nên không bán được.
model WebPushSubscription {
  subscriptionId Int      @id @default(autoincrement()) @map("subscription_id")
  userId         Int      @map("user_id")
  // Endpoint của trình duyệt (Chrome/Firefox cấp) — khoá chống trùng
  endpoint       String   @unique @db.VarChar(500)
  p256dh         String   @db.VarChar(200)
  auth           String   @db.VarChar(100)
  userAgent      String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at")
  // Ghi lại khi gửi thành công để biết subscription còn sống không
  lastUsedAt     DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

// Cấu hình hệ thống dạng khoá/giá trị (VAPID, cờ bật/tắt…) — lưu trong DB để
// không phải cấu hình biến môi trường mỗi khi đổi máy hay redeploy.
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model NotificationLog {
  notificationLogId Int                @id @default(autoincrement()) @map("notification_log_id")
  reminderId        Int                @map("reminder_id")
  deviceId          Int?               @map("device_id")
  action            NotificationAction
  sentAt            DateTime           @default(now()) @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  reminder Reminder @relation(fields: [reminderId], references: [reminderId])
  device   Device?  @relation(fields: [deviceId], references: [deviceId])

  @@index([reminderId, sentAt], map: "ix_notification_logs_reminder_id")
  @@index([deviceId], map: "ix_notification_logs_device_id")
  @@map("notification_logs")
}

// ─── Lịch ngoài (nhập từ Google Calendar / Outlook qua URL .ics) ───────────
// Khách dán URL iCal công khai (Google: Settings → Calendar settings →
// "Secret address in iCal format"). Backend giữ cache sự kiện đã parse để
// trang Lịch hiện ngay, không phải chờ Google mọi lần mở app.
model ExternalCalendar {
  externalCalendarId Int      @id @default(autoincrement()) @map("external_calendar_id")
  userId             Int      @map("user_id")
  name               String   @db.VarChar(120)
  // URL .ics công khai — chỉ đọc, không có quyền ghi gì vào lịch nguồn
  url                String   @db.VarChar(1000)
  color              String   @db.VarChar(16) @default("#7c8cff")
  isActive           Boolean  @default(true) @map("is_active")
  lastSyncedAt       DateTime? @map("last_synced_at")
  lastError          String?  @db.VarChar(300) @map("last_error")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  events   ExternalEvent[]

  @@index([userId], map: "ix_external_calendars_user")
  @@map("external_calendars")
}

// Bản sao sự kiện đã parse — giữ theo uid của nguồn để cập nhật mà không trùng.
model ExternalEvent {
  externalEventId Int      @id @default(autoincrement()) @map("external_event_id")
  calendarId      Int      @map("calendar_id")
  uid             String   @db.VarChar(255)
  title           String   @db.VarChar(300)
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  allDay          Boolean  @default(false) @map("all_day")

  calendar ExternalCalendar @relation(fields: [calendarId], references: [externalCalendarId], onDelete: Cascade)

  @@unique([calendarId, uid], map: "ux_external_events_cal_uid")
  @@index([calendarId, startsAt], map: "ix_external_events_cal_start")
  @@map("external_events")
}

// ─── Lịch học (không gian STUDENT) ──────────────────────────
// Trường học của một lớp học (STUDENT workspace): mỗi Workspace chỉ link đúng
// một trường. TKB import từ URL .ics công khai của trường (hoặc nhập tay) vào
// bảng ScheduleSlot — KHÔNG ép thành Task để lịch học không lẫn vào nhắc nhở
// cá nhân, chỉ hiển thị dạng lớp trên lưới trang Lịch.
model SchoolLink {
  schoolLinkId   Int      @id @default(autoincrement()) @map("school_link_id")
  workspaceId    Int      @unique @map("workspace_id")   // 1 Workspace STUDENT = 1 trường
  name           String   @db.VarChar(150)               // tên trường hiển thị, vd "Bách Khoa TP.HCM"
  // URL .ics TKB công khai của trường/SGU — đồng bộ định kỳ như lịch ngoài Google
  icsUrl         String?  @map("ics_url") @db.VarChar(1000)
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastError      String?  @db.VarChar(300) @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  slots     ScheduleSlot[]

  @@map("school_links")
}

// ─── Tài khoản cổng trường (đăng nhập hộ) ────────────────────────────────
// Một Lớp (Workspace STUDENT) kết nối đúng một tài khoản trường, giống OneUni:
// chọn trường → nhập tài khoản/mật khẩu → hệ thống tự lấy TKB hằng ngày.
// Mật khẩu KHÔNG bao giờ trả về API; chỉ lưu bản mã hoá AES-256-GCM
// (SCHOOL_CRED_KEY) và chỉ dùng để gọi cổng trường theo kiểu chỉ-đọc.
model SchoolAccount {
  schoolAccountId Int      @id @default(autoincrement()) @map("school_account_id")
  workspaceId     Int      @unique @map("workspace_id")
  schoolCode      String   @map("school_code") @db.VarChar(40) // HCMUT | CUSTOM…
  username        String   @db.VarChar(120)                   // BKNetID / tài khoản trường
  // PASSWORD: đăng nhập hộ bằng tài khoản (HCMUT).
  // COOKIE:   trường chưa có connector — dùng phiên đăng nhập sẵn trên trình duyệt
  //           (extension gửi cookie), KHÔNG lưu mật khẩu.
  authType        String   @default("PASSWORD") @map("auth_type") @db.VarChar(20)
  passwordEnc     String?  @map("password_enc") @db.VarChar(500)
  cookieEnc       String?  @map("cookie_enc") @db.VarChar(4000)
  timetableUrl    String?  @map("timetable_url") @db.VarChar(1000)
  mssv            String?  @db.VarChar(30)                    // MSSV lấy từ hồ sơ trường
  status          String   @default("CONNECTED") @db.VarChar(20) // CONNECTED | ERROR
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastError       String?  @db.VarChar(300)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@map("school_accounts")
}

// Một tiết/Tuần học: ocasión lặp hằng tuần (weekDay 1=Thứ 2 … 7=CN) hoặc ngoại
// lệ kiểu "tiết thay đổi vào 20/10" (dateOverride không null = chỉ áp dụng ngày đó).
model ScheduleSlot {
  scheduleSlotId Int      @id @default(autoincrement()) @map("schedule_slot_id")
  schoolLinkId   Int      @map("school_link_id")
  // Tên môn — "Công nghệ phần mềm", không bắt buộc Lehrابق mã lớp
  title          String   @db.VarChar(200)
  room           String?  @db.VarChar(100)
  teacher        String?  @db.VarChar(120)
  weekDay        Int      @map("week_day")               // 1=Thứ 2 … 7=Chủ nhật
  startTime      String   @map("start_time") @db.VarChar(5)  // "07:30"
  endTime        String   @map("end_time") @db.VarChar(5)    // "09:15"
  // Ngoại lệ đơn lẻ (tiết dời ngày): ngàyyyyy-mm-dd + weekDay của ngày đó
  dateOverride   String?  @map("date_override") @db.VarChar(10)
  // Chọn màu hiển thị trên lưới để phân biệt môn — auto theo index nếu không chỉ định
  colorCode      String?  @map("color_code") @db.VarChar(20)
  // Lưu uid gốc của sự kiện .ics — cập nhật/dỡ bỏ sự kiện đã có mà không trùng
  sourceUid      String?  @map("source_uid") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  schoolLink SchoolLink @relation(fields: [schoolLinkId], references: [schoolLinkId], onDelete: Cascade)

  @@unique([schoolLinkId, sourceUid])
  @@index([schoolLinkId, weekDay], map: "ix_schedule_slots_school_weekday")
  @@map("schedule_slots")
}

model CustomSound {
  customSoundId Int      @id @default(autoincrement()) @map("custom_sound_id")
  userId        Int      @map("user_id")
  name          String   @db.VarChar(120)
  mimeType      String   @default("audio/mpeg") @db.VarChar(60) @map("mime_type")
  sizeBytes     Int      @default(0) @map("size_bytes")
  data          Bytes
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "ix_custom_sounds_user_id")
  @@map("custom_sounds")
}

model NotificationSetting {
  notificationSettingId Int      @id @default(autoincrement()) @map("notification_setting_id")
  userId                Int      @unique @map("user_id")
  alarmSound            String   @default("DEFAULT") @db.VarChar(50) @map("alarm_sound")
  defaultSnoozeMinutes  Int      @default(5) @map("default_snooze_minutes")
  vibrationEnabled      Boolean  @default(true) @map("vibration_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("notification_settings")
}

model RefreshToken {
  tokenId   Int      @id @default(autoincrement()) @map("token_id")
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── CSKH: hội thoại hỗ trợ giữa người dùng và admin ────────

enum SupportStatus {
  OPEN
  RESOLVED
}

enum SupportSender {
  USER
  ADMIN
}

// ─── Quyền lợi theo gói: lịch sử đăng ký (nguồn sự thật của gói) ───
// user.plan / planExpiresAt là bản "vật chất hoá" để mọi chỗ kiểm tra gói cũ
// vẫn chạy; mỗi lần kích hoạt/gia hạn đều ghi thêm một dòng ở đây để có lịch sử.
model Subscription {
  subscriptionId Int                @id @default(autoincrement()) @map("subscription_id")
  userId         Int                @map("user_id")
  plan           Plan
  cycle          BillingCycle       @default(MONTHLY)
  provider       BillingProvider
  status         SubscriptionStatus @default(ACTIVE)
  // Mã giao dịch phía nhà cung cấp: mã đơn, purchase token của Play…
  providerRef    String?            @map("provider_ref") @db.VarChar(190)
  startedAt      DateTime           @default(now()) @map("started_at")
  expiresAt      DateTime           @map("expires_at")
  autoRenew      Boolean             @default(false) @map("auto_renew")
  cancelledAt    DateTime?           @map("cancelled_at")
  // Nhắc trước khi hết hạn đã gửi cho kỳ này chưa — mỗi kỳ tối đa 1 lần, nên
  // cột này cũng là chốt chặn chống spam email cho người dùng.
  reminderSentAt DateTime?           @map("reminder_sent_at")
  note           String?            @db.VarChar(255)
  createdAt      DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

// ─── Đơn thanh toán (VietQR trước, Play Billing sau) ────────
model PaymentOrder {
  orderId        Int             @id @default(autoincrement()) @map("order_id")
  orderCode      String          @unique @map("order_code") @db.VarChar(32)
  userId         Int             @map("user_id")
  plan           Plan
  cycle          BillingCycle    @default(MONTHLY)
  amount         Int             // Số tiền VND
  status         OrderStatus     @default(PENDING)
  provider       BillingProvider @default(VIETQR)
  providerRef    String?         @map("provider_ref") @db.VarChar(190)
  // Nội dung chuyển khoản: chính là orderCode để webhook khớp lệnh
  transferContent String         @map("transfer_content") @db.VarChar(120)
  // Mã QR của đơn: do hệ thống tự sinh (SYSTEM) hoặc do ngân hàng tạo qua API (BANK)
  qrPayload       String?        @map("qr_payload") @db.Text
  qrImageUrl      String?        @map("qr_image_url") @db.Text
  qrSource        String?        @map("qr_source") @db.VarChar(10)
  qrCreatedAt     DateTime?      @map("qr_created_at")
  paidAt         DateTime?       @map("paid_at")
  expiresAt      DateTime        @map("expires_at")
  confirmedBy    Int?            @map("confirmed_by")
  note           String?         @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("payment_orders")
}

// ─── Nhật ký sự kiện thanh toán (chống xử lý trùng webhook) ──
model BillingEvent {
  billingEventId Int             @id @default(autoincrement()) @map("billing_event_id")
  provider       BillingProvider
  eventType      String          @map("event_type") @db.VarChar(40)
  // Mã duy nhất phía nhà cung cấp (id giao dịch, purchase token…) → chống trùng
  externalId     String          @unique @map("external_id") @db.VarChar(190)
  orderId        Int?            @map("order_id")
  amount         Int?
  payload        Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("billing_events")
}

// ─── Cấu hình nhận tiền (admin đặt ngay trong app, không cần sửa biến môi trường) ───
// Bảng chỉ có đúng một dòng (settingId = 1). Giá trị ở đây ĐÈ lên biến môi trường,
// nhờ vậy đổi ngân hàng / số tài khoản không phải khởi động lại máy chủ.
model BillingSetting {
  settingId       Int      @id @default(1) @map("setting_id")
  bankId          String?  @map("bank_id") @db.VarChar(20)
  bankAccount     String?  @map("bank_account") @db.VarChar(40)
  bankAccountName String?  @map("bank_account_name") @db.VarChar(80)
  qrTemplate      String?  @map("qr_template") @db.VarChar(20)
  // Mã xác thực webhook (SePay/Casso gửi kèm) — sinh được từ trang quản trị
  webhookSecret   String?  @map("webhook_secret") @db.VarChar(120)

  // ─── Đọc giao dịch bằng API ngân hàng (không cần webhook, không cần xác nhận tay)
  // SEPAY: API Giao dịch của SePay (dùng được ngay). ACB: Open API ACB ONE CONNECT
  // (cần hợp đồng với ACB rồi điền thông số kỹ thuật ACB cấp cho đối tác).
  bankApiProvider     String?   @map("bank_api_provider") @db.VarChar(20)
  bankApiBaseUrl      String?   @map("bank_api_base_url") @db.VarChar(190)
  bankApiToken        String?   @map("bank_api_token") @db.VarChar(255)
  bankApiClientId     String?   @map("bank_api_client_id") @db.VarChar(190)
  bankApiClientSecret String?   @map("bank_api_client_secret") @db.VarChar(255)
  bankApiTokenUrl     String?   @map("bank_api_token_url") @db.VarChar(190)
  bankApiHistoryPath  String?   @map("bank_api_history_path") @db.VarChar(190)
  // Số tài khoản gửi lên API (mặc định lấy số tài khoản nhận tiền ở trên)
  bankApiAccount      String?   @map("bank_api_account") @db.VarChar(40)
  // Đường dẫn tạo QR động của ngân hàng (ACB cấp; dùng được {account} {amount}
  // {content} {orderCode}). Bỏ trống thì hệ thống tự sinh mã VietQR.
  bankApiQrPath       String?   @map("bank_api_qr_path") @db.VarChar(190)
  syncEnabled         Boolean   @default(false) @map("sync_enabled")
  syncIntervalMinutes Int?      @map("sync_interval_minutes")
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncStatus      String?   @map("last_sync_status") @db.VarChar(20)
  lastSyncMessage     String?   @map("last_sync_message") @db.VarChar(255)
  // Con trỏ chống đọc lại giao dịch cũ (since_id của SePay)
  lastSyncCursor      String?   @map("last_sync_cursor") @db.VarChar(60)

  // ─── Nhật ký lần gọi webhook gần nhất ───────────────────
  // SePay gọi webhook bị lỗi mà không ai biết là tiền vào không tự mở gói. Các
  // cột này để trang quản trị hiện đúng sự thật: có gọi tới không, gửi kèm mã
  // gì, và vì sao bị từ chối.
  lastWebhookAt       DateTime? @map("last_webhook_at")
  lastWebhookStatus   String?   @map("last_webhook_status") @db.VarChar(20)
  lastWebhookAuth     String?   @map("last_webhook_auth") @db.VarChar(80)
  lastWebhookMessage  String?   @map("last_webhook_message") @db.VarChar(255)

  updatedBy       Int?     @map("updated_by")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("billing_settings")
}

// ─── Hạn mức dùng AI theo ngày ──────────────────────────────
model AiUsage {
  aiUsageId Int    @id @default(autoincrement()) @map("ai_usage_id")
  userId    Int    @map("user_id")
  // Ngày theo múi giờ Việt Nam, dạng YYYY-MM-DD (so sánh chuỗi cho đơn giản)
  usageDate String @map("usage_date") @db.VarChar(10)
  count     Int    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@map("ai_usage")
}

model SupportConversation {
  supportConversationId Int           @id @default(autoincrement()) @map("support_conversation_id")
  userId                Int           @unique @map("user_id")
  status                SupportStatus @default(OPEN)
  lastMessagePreview    String?       @db.VarChar(160) @map("last_message_preview")
  lastMessageAt         DateTime      @default(now()) @map("last_message_at")
  unreadForAdmin        Int           @default(0) @map("unread_for_admin")
  unreadForUser         Int           @default(0) @map("unread_for_user")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  messages SupportMessage[]

  @@index([lastMessageAt], map: "ix_support_conversations_last_message")
  @@index([unreadForAdmin], map: "ix_support_conversations_unread_admin")
  @@map("support_conversations")
}

model SupportMessage {
  supportMessageId Int           @id @default(autoincrement()) @map("support_message_id")
  conversationId   Int           @map("conversation_id")
  senderRole       SupportSender @map("sender_role")
  authorId         Int?          @map("author_id")
  body             String        @db.Text
  readByUserAt     DateTime?     @map("read_by_user_at")
  readByAdminAt    DateTime?     @map("read_by_admin_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  conversation SupportConversation @relation(fields: [conversationId], references: [supportConversationId], onDelete: Cascade)
  author       User?               @relation("SupportAuthor", fields: [authorId], references: [userId], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@index([conversationId, createdAt], map: "ix_support_messages_conversation")
  @@map("support_messages")
}

/// Ảnh khách hàng/admin gửi kèm trong hội thoại hỗ trợ.
/// Lưu thẳng trong DB (giống custom_sounds) để không phụ thuộc dịch vụ lưu file
/// bên ngoài — client nén ảnh trước khi gửi, server kiểm tra lại dung lượng.
model SupportAttachment {
  supportAttachmentId Int      @id @default(autoincrement()) @map("support_attachment_id")
  messageId           Int      @map("message_id")
  mimeType            String   @db.VarChar(80) @map("mime_type")
  sizeBytes           Int      @default(0) @map("size_bytes")
  data                Bytes
  createdAt           DateTime @default(now()) @map("created_at")

  message SupportMessage @relation(fields: [messageId], references: [supportMessageId], onDelete: Cascade)

  @@index([messageId], map: "ix_support_attachments_message")
  @@map("support_attachments")
}
