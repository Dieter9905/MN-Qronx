{
  "name": "taskalarm-backend",
  "version": "1.0.0",
  "description": "TaskAlarm Backend API – Node.js / Express / Prisma",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "mail:check": "node scripts/check-mail-dns.mjs",
    "mail:test": "node scripts/send-test-email.mjs",
    "mail:send": "node scripts/send-test-email.mjs",
    "mail:status": "node scripts/mailjet-status.mjs",
    "mail:verify": "node scripts/verify-mailjet-domain.mjs",
    "mail:resend": "node scripts/check-resend.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "vitest": "^4.1.11"
  }
}
