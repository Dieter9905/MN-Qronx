# Mode production (npm run build) — Vite ưu tiên file mode-specific hơn .env
# thông thường, nên bản deploy lên VPS LUÔN cứng URL thật, không bao giờ
# dính VITE_API_URL=localhost như .env dùng cho dev — từng gặp thật: toàn bộ
# API của trang mn-qronx.id.vn ném về localhost:8081 của máy dev, Google
# login + đăng nhập đều quay về máy người dùng.
VITE_API_URL=https://mn-qronx.id.vn/api/v1
